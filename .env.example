# ==============================================================================
# AI Software Factory - Environment Configuration Template
# Copy this file to '.env' and populate with your credentials.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# LLM Provider API Keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Default Provider & Routing Settings
DEFAULT_LLM_PROVIDER=groq
DEFAULT_FALLBACK_PROVIDER=openrouter
DEFAULT_EMBEDDING_PROVIDER=gemini

# Application Environment (development, testing, production)
FACTORY_ENV=development
LOG_LEVEL=INFO

# Model Gateway Settings
GATEWAY_REQUEST_TIMEOUT_SECONDS=60
GATEWAY_MAX_RETRIES=3
GATEWAY_RETRY_BACKOFF_FACTOR=2.0

# Sandbox Execution Policy
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_ALLOW_NETWORK=false

